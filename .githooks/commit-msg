#!/bin/sh
# Validate Conventional Commits headers: https://www.conventionalcommits.org/
set -eu

if [ "$#" -ne 1 ] || [ ! -r "$1" ]; then
  printf '%s\n' 'commit-msg: expected a readable commit message file.' >&2
  exit 1
fi

# Use the first non-empty, non-comment line as the header.
header=$(sed -n '/^#/d; /^[[:space:]]*$/d; p; q' "$1")

# Preserve messages generated by Git for these operations.
case "$header" in
  "Merge "*|"Revert "*|"fixup! "*|"squash! "*) exit 0 ;;
esac

types='feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert'
pattern="^(${types})(\([a-z0-9._/-]+\))?!?: [^[:space:]].*$"

if ! printf '%s\n' "$header" | grep -Eq "$pattern"; then
  cat >&2 <<EOF
commit-msg: header does not follow Conventional Commits.

  Got:      $header

  Expected: <type>[(scope)][!]: <description>
  Types:    feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert

  Examples:
    feat(rsa): implement PSS verification
    fix(rsa): reject signatures with invalid lengths
    test(sha256): add streaming boundary cases
    docs: clarify the learning workflow
    feat(rsa)!: change private key construction
EOF
  exit 1
fi

if [ "${#header}" -gt 72 ]; then
  printf 'commit-msg: header is %s characters; keep it at most 72.\n' "${#header}" >&2
  exit 1
fi
